<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Motion Mode">
<meta name="theme-color" content="#0b0b0c">
<title>MOTION MODE</title>
<style>
:root{--bg:#0b0b0c;--card:#17181a;--card2:#1f2124;--tx:#fff;--tx2:#9a9ea5;--ac:#c6ff00;--ac-ink:#0b0b0c;--bad:#ff5d5d}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:var(--bg);color:var(--tx);font:16px/1.4 ui-rounded,system-ui,-apple-system,sans-serif}
#app{height:100%;display:flex;flex-direction:column;padding-top:env(safe-area-inset-top)}
main{flex:1;overflow-y:auto;padding:16px 16px 24px}
h1,h2,h3,p{margin:0}
.brand{font-weight:900;letter-spacing:.04em;font-size:22px}.brand b{color:var(--ac)}
.slogan{color:var(--tx2);font-size:14px;margin-top:2px}
.card{background:var(--card);border-radius:22px;padding:16px;margin-top:14px}
.row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.sub{color:var(--tx2);font-size:14px}
.big{font-size:44px;font-weight:900;font-variant-numeric:tabular-nums;line-height:1}
.btn{display:block;width:100%;border:0;border-radius:18px;padding:16px;font-weight:800;font-size:17px;font-family:inherit;background:var(--ac);color:var(--ac-ink);cursor:pointer}
.btn.alt{background:var(--card2);color:var(--tx)}.btn.bad{background:#2a1517;color:var(--bad)}
.btn:active{transform:scale(.98)}.btn:disabled{opacity:.4}
.bar{height:10px;border-radius:9px;background:var(--card2);overflow:hidden;margin-top:10px}
.bar i{display:block;height:100%;background:var(--ac);border-radius:9px;transition:width .3s}
nav{display:flex;background:#101112;border-top:1px solid #222;padding-bottom:env(safe-area-inset-bottom)}
nav button{flex:1;background:none;border:0;color:var(--tx2);padding:12px 0 10px;font-weight:700;font-size:12px;font-family:inherit}
nav button.on{color:var(--ac)}
.chip{display:inline-block;background:var(--card2);color:var(--tx);border:0;font-family:inherit;border-radius:20px;padding:6px 12px;font-size:13px;font-weight:700}
.chip.on{background:var(--ac);color:var(--ac-ink)}
.opts{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.mis{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-top:1px solid #26282b}
.mis:first-of-type{border-top:0}.done{color:var(--ac)}
.step{display:flex;align-items:center;gap:18px;justify-content:center;margin-top:10px}
.step button{width:48px;height:48px;border-radius:50%;border:0;background:var(--card2);color:var(--tx);font-size:26px;font-weight:800}
.chart{display:flex;align-items:flex-end;gap:8px;height:110px;margin-top:12px}
.chart div{flex:1;text-align:center;font-size:11px;color:var(--tx2)}
.chart i{display:block;background:var(--ac);border-radius:6px 6px 0 0;min-height:3px;margin-bottom:4px}
#cam{position:fixed;inset:0;background:#000;z-index:10;display:none}
#cam video,#cam canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#cam.front video,#cam.front canvas{transform:scaleX(-1)}
#hud{position:absolute;left:0;right:0;top:0;padding:calc(env(safe-area-inset-top) + 12px) 16px 16px;background:linear-gradient(#000c,#0000);text-align:center}
#cnt{font-size:120px;font-weight:900;line-height:1;color:var(--ac);font-variant-numeric:tabular-nums}
#fb{position:absolute;left:16px;right:16px;bottom:calc(env(safe-area-inset-bottom) + 84px);text-align:center;font-weight:800;background:#000a;border-radius:16px;padding:12px}
#camBtns{position:absolute;left:16px;right:16px;bottom:calc(env(safe-area-inset-bottom) + 16px);display:flex;gap:10px}
.ov{position:fixed;inset:0;background:#0b0b0cf2;z-index:20;display:none;flex-direction:column;justify-content:center;padding:28px;text-align:center;gap:14px}
.ov.show{display:flex}
:focus-visible{outline:3px solid var(--ac);outline-offset:2px}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div id="app"><main id="main"></main>
<nav id="nav"></nav></div>

<div id="cam"><video id="vid" playsinline muted></video><canvas id="cv"></canvas>
<div id="hud"><div class="sub" id="hudT"></div><div id="cnt">0</div><div class="bar"><i id="hudB" style="width:0"></i></div></div>
<div id="fb">Loading…</div>
<div id="camBtns"><button class="btn alt" id="flip">Flip camera</button><button class="btn bad" id="stop">End</button></div></div>

<div class="ov" id="ov"></div>

<script type="module">
import {PoseLandmarker,FilesetResolver} from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/+esm";

