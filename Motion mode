 {id:'d2',p:'d',t:'Do 20 push-ups today',xp:25,v:()=>S.sessions.filter(s=>s.day===today()).reduce((a,s)=>a+s.reps,0),g:20},
 {id:'w1',p:'w',t:'3 workouts this week',xp:50,v:()=>sessionsIn(+weekStart()).length,g:3},
 {id:'w2',p:'w',t:'100 push-ups this week',xp:80,v:()=>sessionsIn(+weekStart()).reduce((a,s)=>a+s.reps,0),g:100}];
const pkey=m=>m.id+':'+(m.p==='d'?today():day(weekStart()));
const ACH=[
 ['first','First rep set','Complete a workout',()=>S.sessions.length>=1],
 ['s3','On a roll','3-day streak',()=>streak()>=3],
 ['s7','Locked in','7-day streak',()=>streak()>=7],
 ['r100','Century','100 total push-ups',()=>tot()>=100],
 ['r500','Iron','500 total push-ups',()=>tot()>=500],
 ['l5','Level 5','Reach level 5',()=>levelOf(totalXp())>=5]];
